# Build outputs and local development state.
target/
/.lumeryn-scratch/
/projects/
/exports/
/renders/
/models/
/cache/
/.cache/
.vs/
__pycache__/
*.log
*.tmp

# User projects, source media and generated output stay local.
*.lumeryn
*.lumeryn-wal
*.lumeryn-shm
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
*.mp4
*.mkv
*.mov
*.avi
*.webm
*.m4v
*.wav
*.mp3
*.m4a
*.aac
*.flac
*.ogg
*.png
*.jpg
*.jpeg
*.webp

# Credentials and private signing material; examples may be tracked.
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.pfx
*.p12

# Reviewed redistributable catalogue assets are part of the application.
!assets/library/**/*.png
!assets/library/**/*.ogg
!assets/library/**/*.wav
!assets/library/**/*.jpg
!assets/library/**/*.jpeg
!assets/library/**/*.webp
